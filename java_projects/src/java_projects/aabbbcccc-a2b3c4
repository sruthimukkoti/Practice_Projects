import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        //aabbbcccc → a2b3c4
        String input = sc.nextLine();
        StringBuilder result = new StringBuilder();

        int count = 1;

        for (int i = 0; i < input.length(); i++) {
            // If next character is same, increase count
            if (i < input.length() - 1 && input.charAt(i) == input.charAt(i + 1)) {
                count++;
            } else {
                // Append character and its count
                result.append(input.charAt(i)).append(count);
                count = 1;
            }
        }

        System.out.println(result.toString());
        sc.close();
    }
}

public class ConvertNumricToCharExample {

static void convertNumToChar(String s) {

for(int i =0; i < s.length(); i++) {
if(Character.isAlphabetic(s.charAt(i))){
System.out.print(s.charAt(i));
}else {
int a = Character.getNumericValue(s.charAt(i));
for(int j =1; j <a; j++) {
System.out.print(s.charAt(i-1));
}
}
}

}

public static void main(String[] args) {

String str = "a2b3c4"; //output = aabbbcccc
convertNumToChar(str);

}

}
